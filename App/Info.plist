	<string>Verbindung zu deinem Fotoserver im Heimnetz.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Damit Fotos vom Server auf dem iPhone gespeichert werden können.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Damit deine Fotos auf deinem eigenen Server gesichert werden.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
