{
  "sourceLanguage": "de",
  "strings": {
    "%lld fehlgeschlagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld failed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибок: %lld"
          }
        }
      }
    },
    "%lld gesichert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld backed up"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено: %lld"
          }
        }
      }
    },
    "%lld Objekte auf deinen Server sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up %lld items to your server"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить объекты (%lld) на ваш сервер"
          }
        }
      }
    },
    "%lld waren schon da": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld were already there"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже на сервере: %lld"
          }
        }
      }
    },
    "1 Objekt auf deinen Server sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up 1 item to your server"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить 1 объект на ваш сервер"
          }
        }
      }
    },
    "Abbrechen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Auf deinem Server sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up to Your Server"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить на сервер HomeRoll"
          }
        }
      }
    },
    "Bitte zuerst die Fotos-App öffnen und anmelden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please open HomeRoll and sign in first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, сначала откройте приложение HomeRoll и войдите в аккаунт."
          }
        }
      }
    },
    "Fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Fotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото"
          }
        }
      }
    }
  },
  "version": "1.1"
}