    "Das beste Foto bleibt, die anderen kommen in „Zuletzt gelöscht“ (30 Tage wiederherstellbar).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best photo stays, the others go to “Recently Deleted” (recoverable for 30 days)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее фото останется, а копии переместятся в «Недавно удаленные» (доступны 30 дней)."
          }
        }
      }
    },
