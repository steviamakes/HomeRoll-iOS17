          }
        }
      }
    },
    "Diashow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slideshow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слайд-шоу"
          }
        }
      }
    },
    "Die App merkt sich, wann sie hängt oder beim Scrollen ruckelt – ohne Fotos oder Namen. Schick das Protokoll, wenn etwas langsam ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app notes when it hangs or stutters while scrolling – without photos or names. Send the log if something is slow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал производительности фиксирует задержки интерфейса без личных данных."
          }
        }
      }
    },
    "Die Fotos und Videos bleiben in deiner Mediathek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos and videos stay in your library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сами фото и видео останутся в вашей медиатеке."
          }
        }
      }
    },
    "Diese %lld Fotos werden ausgeblendet, sind aber weiterhin im Album „Ausgeblendet“ zu sehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld photos will be hidden, but you can still see them in the Hidden album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти фото (%lld) будут скрыты из медиатеки, но останутся доступны в альбоме «Скрытые»."
          }
        }
      }
    },
    "Diese %lld Objekte werden ausgeblendet, sind aber weiterhin im Album „Ausgeblendet“ zu sehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld items will be hidden, but you can still see them in the Hidden album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты (%lld) будут скрыты из медиатеки, но останутся доступны в альбоме «Скрытые»."
          }
        }
      }
    },
    "Diese %lld Objekte werden endgültig gelöscht. Dieser Vorgang kann nicht widerrufen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld items will be permanently deleted. This action can’t be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты (%lld) будут удалены навсегда. Это действие нельзя отменить."
          }
        }
      }
    },
    "Diese %lld Personen sind „%@“?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Diese %1$lld Personen sind „%2$@“?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are these %1$lld people “%2$@”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить этих людей (%1$lld) под именем «%2$@»?"
          }
        }
      }
    },
    "Diese %lld Videos werden ausgeblendet, sind aber weiterhin im Album „Ausgeblendet“ zu sehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld videos will be hidden, but you can still see them in the Hidden album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти видео (%lld) будут скрыты из медиатеки, но останутся доступны в альбоме «Скрытые»."
          }
        }
      }
    },
    "Diese Objekte kommen in „Zuletzt gelöscht“ und bleiben dort 30 Tage wiederherstellbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items go to “Recently Deleted” and can be recovered there for 30 days."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты будут перемещены в «Недавно удаленные», где их можно восстановить в течение 30 дней."
          }
        }
      }
    },
    "Diese Person ist „%@“?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this person “%@”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот человек — «%@»?"
          }
        }
      }
    },
    "Diese Personen sehen alle deine Fotos (nicht „Ausgeblendet“ und „Zuletzt gelöscht“). Nur Nutzer deines eigenen Servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These people see all your photos (except “Hidden” and “Recently Deleted”). Only users of your own server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти пользователи вашего сервера видят ваши фото (кроме «Скрытых» и «Недавно удаленных»)."
          }
        }
      }
    },
    "Diese Tage erscheinen seltener": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These days will be featured less"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти дни будут показываться реже"
          }
        }
      }
    },
    "Diese Tage weniger zeigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature These Days Less"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать эти дни реже"
          }
        }
      }
    },
    "Dieses Album ist leer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is empty."
