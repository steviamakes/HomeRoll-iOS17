    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Damit „Ausgeblendet“ und „Zuletzt gelöscht“ nur du öffnen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So only you can open “Hidden” and “Recently Deleted”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы только вы могли открывать альбомы «Скрытые» и «Недавно удаленные»."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Verbindung zu deinem Fotoserver im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection to your photo server on the home network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подключения к вашему домашнему фото-серверу в локальной сети."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Damit Fotos vom Server auf dem iPhone gespeichert werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So photos from your server can be saved to the iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сохранять фотографии и видео с сервера на iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Damit deine Fotos auf deinem eigenen Server gesichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So your photos can be backed up to your own server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для резервного копирования ваших фото и видео на домашний сервер."
          }
        }
      }
    }
  },
  "version": "1.1"
